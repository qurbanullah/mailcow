# =============================================================================
# mailcow deployment - .gitignore
#
# mailcow.env and backup/mailcow-backup.env ARE tracked (they contain the
# deployment configuration, so a fresh clone works with no extra steps).
#
# WARNING: backup/mailcow-backup.env holds your IDrive e2 credentials and
# the restic password - keep this repository PRIVATE.
#
# The files below are generated secrets / keys that must never be committed.
# =============================================================================

# ---- generic environment files (mailcow internals) ----
.env

# ---- mailcow-generated config (contains DBPASS / DBROOT / REDISPASS) ----
mailcow.conf
mailcow.conf.*

mailcow.env
backup/mailcow-backup.env

# ---- TLS certificates / private keys / SSH keys ----
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.asc
*.gpg
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.ppk
.ssh/
authorized_keys

# ---- backup artifacts (mailbox data could end up here) ----
*.tar
*.tar.gz
*.tgz
*.tar.zst
*.zst
*.zip

# ---- logs ----
*.log

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
*~
*.swp
*.swo
.idea/
.vscode/
